{
  "name": "lyrics-studio",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "description": "ローカルで動作する、日本語の読み・モーラと英語のシラブルを扱う作詞エディター",
  "repository": { "type": "git", "url": "git+https://github.com/exveria1015/LyricStudio.git" },
  "bugs": { "url": "https://github.com/exveria1015/LyricStudio/issues" },
  "type": "module",
  "scripts": {
    "dev": "node scripts/run-studio.mjs dev",
    "build": "tsc -b && vite build && node scripts/build-notices.mjs && node scripts/build-offline.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "dictionary:build": "node scripts/build-dictionary.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "start": "node scripts/run-studio.mjs serve",
    "setup:readings": "node scripts/readings.mjs setup",
    "test:readings": "node scripts/readings.mjs test",
    "check:readings": "node scripts/readings.mjs check",
    "dev:readings": "node scripts/readings.mjs serve"
  },
  "dependencies": {
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-ruby-text": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "lucide-react": "1.59.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.1.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "overrides": {
    "eslint": { "minimatch": "11.0.8" },
    "@eslint/config-array": { "minimatch": "11.0.8" },
    "@typescript-eslint/typescript-estree": { "minimatch": "11.0.8" }
  },
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  }
}
